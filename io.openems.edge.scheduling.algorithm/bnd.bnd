Bundle-Name: EnergyPro Scheduling Algorithm (OpenEMS-free core)
Bundle-Vendor: EnergyPro
Bundle-Version: 1.0.0.${tstamp}

# Deliberately near-empty: this bundle is plain Java with zero OpenEMS/OSGi
# dependencies in its actual algorithm code, so the per-resource DP table,
# Slot Cost, Least Slack Time and forward-walk algorithms stay portable to
# any future runtime (e.g. a Node.js/Homey port) without needing to be
# untangled from the OSGi Component/Channel model first. See
# docs/architecture/controller-inventory.md's "Implementation principle —
# keep every algorithm OpenEMS-free". osgi.annotation is the one exception:
# build-time-only package-export metadata (package-info.java), analogous to
# a package.json — not referenced by, or relevant to porting, the algorithm
# classes themselves.
-buildpath: \
	osgi.annotation;version='8.1.0',\

-testpath: \
	${testpath}
